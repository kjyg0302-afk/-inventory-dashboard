# 이 파일을 secrets.toml로 복사한 뒤 실제 값을 채워 넣으세요.
# (secrets.toml은 .gitignore에 등록되어 있어 깃에 올라가지 않습니다)
#
# Streamlit Cloud에 배포한 경우에는 이 파일 대신
# 앱 설정 > Secrets 메뉴에 아래 내용을 그대로 붙여넣으면 됩니다.
#
# Supabase 프로젝트 > Project Settings > Database > Connection string에서
# "Transaction pooler" 문자열을 복사해 [YOUR-PASSWORD] 부분만 실제 비밀번호로 바꾸세요.
# (Direct connection이 아니라 Transaction pooler를 써야 IPv4 환경에서도 접속됩니다)

[connections.supabase_db]
url = "postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"
